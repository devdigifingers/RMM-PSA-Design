[Unit]
Description=Refresh the MaxMind GeoLite2-City and GeoLite2-ASN databases used for device locations and providers
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/GeoIP.conf

[Service]
Type=oneshot
ExecStart=/usr/bin/geoipupdate -f /etc/GeoIP.conf -d /var/lib/GeoIP
NoNewPrivileges=true
