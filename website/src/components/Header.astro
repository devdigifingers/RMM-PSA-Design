---
import { NAV, CONSOLE_URL, href, brand } from "../site.js";

const base = import.meta.env.BASE_URL.replace(/\/+$/, "");
const here = Astro.url.pathname.slice(base.length) || "/";
const current = (path) => (here === path ? "page" : here.startsWith(path) && path !== "/" ? "true" : undefined);
---
<header class="site-header">
  <a class="logo-link" href={href("/")} aria-label="Digital Fingers home">
    <img class="logo" src={brand("/brand/logo-horizontal-dark.svg")} alt="Digital Fingers" width="517" height="120" />
  </a>
  <nav class="primary-nav" aria-label="Primary">
    <ul>
      {NAV.map((item) => (
        <li>
          {item.children ? (
            <details class="nav-drop">
              <summary aria-current={current(item.path)}>{item.label}</summary>
              <ul class="dropdown">
                <li><a href={href(item.path)}><strong>All solutions</strong><span>Every product, side by side</span></a></li>
                {item.children.map((child) => (
                  <li><a href={href(child.path)}><strong>{child.label}</strong><span>{child.note}</span></a></li>
                ))}
              </ul>
            </details>
          ) : (
            <a href={href(item.path)} aria-current={current(item.path)}>{item.label}</a>
          )}
        </li>
      ))}
    </ul>
  </nav>
  <div class="header-actions">
    <a class="btn btn-ghost logon" href={CONSOLE_URL}>Log on</a>
    <a class="btn btn-primary" href={href("/signup/")}>Start free</a>
    <details class="menu">
      <summary aria-label="Menu">
        <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><path d="M3 5h14M3 10h14M3 15h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
      </summary>
      <nav class="menu-panel" aria-label="Menu">
        <ul>
          {NAV.map((item) => (
            <>
              <li><a href={href(item.path)}>{item.label}</a></li>
              {item.children && item.children.map((child) => (
                <li class="sub"><a href={href(child.path)}>{child.label}</a></li>
              ))}
            </>
          ))}
          <li><a href={href("/contact/")}>Contact</a></li>
        </ul>
        <div class="menu-actions">
          <a class="btn btn-outline" href={CONSOLE_URL}>Log on</a>
          <a class="btn btn-primary" href={href("/signup/")}>Start free</a>
        </div>
      </nav>
    </details>
  </div>
</header>
